generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One persisted chat turn for the AI coach. Messages carry no user
/// identifiers — only a client-generated UUID session key.
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// A household commitment to a low-emission action from the catalog.
model Commitment {
  id        String   @id @default(cuid())
  sessionId String
  actionId  String
  createdAt DateTime @default(now())

  @@unique([sessionId, actionId])
  @@index([sessionId])
}
